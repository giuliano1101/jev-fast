{
  "name": "jev-p0",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/tests/unit/*.test.js dist/tests/safety/core.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "test:safety": "npm run build && node --test dist/tests/safety/*.test.js",
    "bench:mock": "npm run build && node dist/bench/run.js",
    "start:service": "node dist/src/service/main.js",
    "start:mcp": "node dist/src/mcp/index.js",
    "cli": "node dist/src/cli/index.js",
    "gateway": "node dist/src/remote/main.js",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.61.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "description": "Bounded Jev browser execution MVP and graded computer-use comparison",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/giuliano1101/jev-fast.git"
  }
}
